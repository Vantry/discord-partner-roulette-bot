# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here

# Guild and Channel IDs
EVENT_GUILD_ID=123456789
EVENT_CHANNEL_ID=123456789
PARTNER_CHANNEL_ID=123456789
MOD_CHANNEL_ID=123456789
APPLICATION_CATEGORY_ID=123456789

# Roles
MOD_ROLE_ID=123456789
EVENT_ROLE_ID=123456789

# Event Scheduling
EVENT_TIMEZONE=Europe/Berlin
EVENT_DAY=0
EVENT_HOUR=20
EVENT_MINUTE=0

# Activity Points Configuration
MESSAGE_POINTS=1
MESSAGE_COOLDOWN=300
JOIN_POINTS=2
RETENTION_POINTS=3
RETENTION_HOURS=24
ACTIVE_USER_POINTS=5
VOICE_POINTS=1
VOICE_INTERVAL=300
VOICE_MAX_WEEKLY=120

# GIF URLs for Events
ELIMINATION_GIFS=https://media.giphy.com/media/example1.gif,https://media.giphy.com/media/example2.gif,https://media.giphy.com/media/example3.gif

# Logging
LOG_LEVEL=INFO
DATABASE_PATH=./data/bot.db
